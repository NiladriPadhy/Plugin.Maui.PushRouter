<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PushRouter.Sample.MainPage"
             Title="Push Router">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Plugin.Maui.PushRouter"
                   FontSize="26"
                   FontAttributes="Bold" />
            <Label x:Name="PlatformLabel"
                   Text="Platform: unknown"
                   TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />
            <Label Text="Simulate FCM / APNs payloads. Taps open Order or Chat. Foreground receives stay here and log."
                   LineBreakMode="WordWrap" />

            <Label Text="Simulate" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Button Text="FCM tap → order" Clicked="OnFcmTapClicked" />
                <Button Grid.Column="1" Text="APNs tap → chat" Clicked="OnApnsTapClicked" />
                <Button Grid.Row="1" Text="Foreground receive" Clicked="OnReceiveClicked" />
                <Button Grid.Row="1" Grid.Column="1" Text="Silent handler" Clicked="OnSilentClicked" />
                <Button Grid.Row="2" Text="Unknown route" Clicked="OnUnknownClicked" />
                <Button Grid.Row="2" Grid.Column="1" Text="Path in payload" Clicked="OnPathClicked" />
            </Grid>

            <Label Text="Last notification" FontAttributes="Bold" />
            <Label x:Name="LastLabel" LineBreakMode="WordWrap" Text="None yet." />

            <Label Text="Log" FontAttributes="Bold" />
            <Border Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                    StrokeThickness="1"
                    Padding="12"
                    StrokeShape="RoundRectangle 8">
                <Label x:Name="LogLabel"
                       Text="Ready."
                       FontSize="12"
                       LineBreakMode="WordWrap" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
